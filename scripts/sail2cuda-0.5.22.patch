+# limitations under the License.
+# ==============================================================================
+"""sgl-kernel build script for the T-HEAD SAIL (PPU) platform.
+
+SAIL exposes a CUDA-compatible toolchain: ``nvcc`` on a SAIL host is the PPU
+SDK's CUDA compiler driver -- it reads ``.cu`` sources directly and accepts
+standard ``-gencode=arch=compute_80,code=sm_80`` targets, and the SDK ships
+real ``libcudart``/``libcublas``/``libcublasLt``/``libcuda``.  This build
+therefore mirrors the upstream CUDA ``CUDAExtension`` path (no source
+translation, no separate device compiler).
+
+Only the SM80 op surface is registered (``csrc/common_extension_sail.cc``):
+the SM90+/CUTLASS kernels trimmed from it do not target the ZW810E (capability
+8.0) and are dispatched through PPU-native backends at runtime instead.  The
+trimmed op wrappers in ``python/sgl_kernel`` resolve ``torch.ops`` lazily, so
+``import sgl_kernel`` stays valid on a trimmed build.
+
+Environment overrides:
+  SGL_KERNEL_THIRD_PARTY_DIR   where to clone/find actlize, flashinfer, triton
+  SGL_KERNEL_ACTLIZE_DIR       pre-existing actlize checkout
+  SGL_KERNEL_SKIP_THIRD_PARTY  "1" to skip cloning third-party repos
+  SGL_KERNEL_CUDA_GENCODE      override the default sm80 gencode target(s)
+  SGL_KERNEL_ENABLE_BF16/FP8   toggle flashinfer bf16/fp8 defines (default on)
+  SGL_KERNEL_COMPILE_THREADS   nvcc --threads (default 32)
+
+Build from this directory so the relative source paths resolve. Use the
+wheel + ``pip install --no-deps`` flow, NOT ``python setup_sail.py install``:
+the in-tree ``pyproject.toml`` statically pins ``torch==2.14.1``, and the
+``install`` command's easy_install step would resolve that pin and overwrite
+the PPU-customized torch. ``--no-deps`` keeps the installed torch untouched.
+
+  cd python/sglang/kernels/aot
+  python setup_sail.py bdist_wheel
+  pip install --no-deps --force-reinstall dist/sglang_kernel-*.whl
+"""
+
+import os
+import platform
+import re
+import subprocess
+from pathlib import Path
+
+import torch
+from setuptools import find_namespace_packages, setup
+from torch.utils.cpp_extension import BuildExtension, CUDAExtension
+
+root = Path(__file__).parent.resolve()
+third_party = Path(
+    os.environ.get("SGL_KERNEL_THIRD_PARTY_DIR", root / "build" / "_deps")
+)
+arch = platform.machine().lower()
+
+# ======================= CUDA Version Detection ======================= #
+cuda_version = torch.version.cuda
+if cuda_version is None:
+    raise RuntimeError("CUDA is not available in the current PyTorch installation.")
+
+cuda_version_tuple = tuple(int(x) for x in cuda_version.split(".")[:2])
+print(f"Detected CUDA version: {cuda_version} ({cuda_version_tuple})")
+
+
+# ======================= Third-Party Repository Info ======================= #
+class _RepoInfo:
+    """Configuration for a third-party git repository."""
+
+    def __init__(self, name, git_repository, git_tag, git_shallow=False):
+        self.name = name
+        self.git_repository = git_repository
+        self.git_tag = git_tag
+        self.git_shallow = git_shallow
+        self.source_dir = third_party / name
+
+
+_ACTLIZE_REPO = _RepoInfo(
+    name="actlize",
+    git_repository="https://github.com/t-head/actlize",
+    git_tag="129651181ed29ec3d3e61df786f610926b739a9b",
+    git_shallow=False,
+)
+
+_ACTLIZE_DIR = Path(os.environ.get("SGL_KERNEL_ACTLIZE_DIR", _ACTLIZE_REPO.source_dir))
+
+_FLASHINFER_REPO = _RepoInfo(
+    name="flashinfer",
+    git_repository="https://github.com/flashinfer-ai/flashinfer.git",
+    git_tag="bc29697ba20b7e6bdb728ded98f04788e16ee021",
+    git_shallow=False,
+)
+
+_TRITON_REPO = _RepoInfo(
+    name="triton",
+    git_repository="https://github.com/triton-lang/triton",
+    git_tag="v3.7.0",
+    git_shallow=False,
+)
+
+ALL_REPOS = [
+    _ACTLIZE_REPO,
+    _FLASHINFER_REPO,
+    _TRITON_REPO,
+]
+
+
+# ======================= Version ======================= #
+def _get_version():
+    # Reuse the version declared by the in-tree pyproject.toml so the SAIL
+    # wheel tracks the same sglang-kernel version as the CUDA build.
+    with open(root / "pyproject.toml") as f:
+        for line in f:
+            m = re.match(r'^version\s*=\s*"([^"]+)"', line)
+            if m:
+                return m.group(1)
+    return "0.0.0"
+
+
+# ======================= Build Configuration ======================= #
+operator_namespace = "sgl-kernel"
+
+# Determine CXX ABI compatibility with PyTorch
+torch_cxx11_abi = int(torch._C._GLIBCXX_USE_CXX11_ABI)
+abi_flag = f"-D_GLIBCXX_USE_CXX11_ABI={torch_cxx11_abi}"
+
+enable_bf16 = os.environ.get("SGL_KERNEL_ENABLE_BF16", "1").lower() in (
+    "1",
+    "true",
+    "on",
+    "yes",
+)
+enable_fp8 = os.environ.get("SGL_KERNEL_ENABLE_FP8", "1").lower() in (
+    "1",
+    "true",
+    "on",
+    "yes",
+)
+compile_threads = int(os.environ.get("SGL_KERNEL_COMPILE_THREADS", "32"))
+if compile_threads < 1:
+    compile_threads = 1
+
+# ======================= NVCC Flags ======================= #
+# The SAIL nvcc accepts standard CUDA gencode targets. ZW810E is capability
+# (8, 0), so the default fatbin targets sm_80 only; override via
+# SGL_KERNEL_CUDA_GENCODE (space-separated) for other SAIL parts.
+_default_gencode = "-gencode=arch=compute_80,code=sm_80"
+_gencode_flags = os.environ.get("SGL_KERNEL_CUDA_GENCODE", _default_gencode).split()
+
+sgl_kernel_cuda_flags = [
+    "-DNDEBUG",
+    f"-DOPERATOR_NAMESPACE={operator_namespace}",
+    "-O3",
+    "-Xcompiler",
+    "-fPIC",
+    *_gencode_flags,
+    "-std=c++17",
+    "-DFLASHINFER_ENABLE_F16",
+    "-DCUTE_USE_PACKED_TUPLE=1",
+    "-DCUTLASS_ENABLE_TENSOR_CORE_MMA=1",
+    "-DCUTLASS_VERSIONS_GENERATED",
+    "-DCUTLASS_TEST_LEVEL=0",
+    "-DCUTLASS_TEST_ENABLE_CACHED_RESULTS=1",
+    "-DCUTLASS_DEBUG_TRACE_LEVEL=0",
+    "--expt-relaxed-constexpr",
+    "--expt-extended-lambda",
+    "-U__CUDA_NO_HALF_OPERATORS__",
+    "-U__CUDA_NO_HALF_CONVERSIONS__",
+    "-U__CUDA_NO_HALF2_OPERATORS__",
+    "-U__CUDA_NO_BFLOAT16_CONVERSIONS__",
+    f"--threads={compile_threads}",
+    # Suppress warnings
+    "-Xcompiler=-Wno-clang-format-violations",
+    "-Xcompiler=-Wno-conversion",
+    "-Xcompiler=-Wno-deprecated-declarations",
+    "-Xcompiler=-Wno-terminate",
+    "-Xcompiler=-Wfatal-errors",
+    "-Xcompiler=-ftemplate-backtrace-limit=1",
+    "-Xcudafe=--diag_suppress=177",
+    "-Xcudafe=--diag_suppress=2361",
+    f"-Xcompiler={abi_flag}",
+    abi_flag,
+]
+
+if enable_bf16:
+    sgl_kernel_cuda_flags.append("-DFLASHINFER_ENABLE_BF16")
+
+if enable_fp8:
+    sgl_kernel_cuda_flags.extend(
+        [
+            "-DFLASHINFER_ENABLE_FP8",
+            "-DFLASHINFER_ENABLE_FP8_E4M3",
+            "-DFLASHINFER_ENABLE_FP8_E5M2",
+        ]
+    )
+
+# ======================= Include Directories ======================= #
+include_dirs = [
+    str(root / "include"),
+    str(root / "csrc"),
+    # Speculative device kernels are shared with the JIT launchers.
+    str(root.parent / "jit" / "include"),
+    str(_ACTLIZE_DIR / "include"),
+    str(_ACTLIZE_DIR / "tools" / "util" / "include"),
+    str(_FLASHINFER_REPO.source_dir / "include"),
+    str(_FLASHINFER_REPO.source_dir / "csrc"),
+    str(_ACTLIZE_DIR / "examples" / "77_blackwell_fmha"),
+    str(_ACTLIZE_DIR / "examples" / "common"),
+]
+
+# ======================= Source Files ======================= #
+# SM80 op surface only -- matches csrc/common_extension_sail.cc. The
+# SM90+/CUTLASS kernels (fp8/int8 scaled_mm, cutlass_w4a8_moe, es_sm100_*,
+# dsv4_fused_*, infllm_v2_*) are intentionally excluded; they do not target
+# ZW810E and are served by PPU-native backends at runtime.
+common_sources = [
+    "csrc/allreduce/custom_all_reduce.cu",
+    "csrc/attention/merge_attn_states.cu",
+    "csrc/common_extension_sail.cc",
+    "csrc/elementwise/activation.cu",
+    "csrc/elementwise/concat_mla.cu",
+    "csrc/elementwise/copy.cu",
+    "csrc/elementwise/fused_add_rms_norm_kernel.cu",
+    "csrc/elementwise/pos_enc.cu",
+    "csrc/elementwise/topk.cu",
+    "csrc/gemm/per_token_group_quant_8bit.cu",
+    "csrc/gemm/per_token_group_quant_8bit_v2.cu",
+    "csrc/gemm/per_token_quant_fp8.cu",
+    "csrc/grammar/apply_token_bitmask_inplace_cuda.cu",
+    "csrc/kvcacheio/transfer.cu",
+    "csrc/mamba/causal_conv1d.cu",
+    "csrc/memory/weak_ref_tensor.cpp",
+    "csrc/moe/moe_align_kernel.cu",
+    "csrc/moe/fused_qknorm_rope_kernel.cu",
+    "csrc/moe/moe_sum.cu",
+    "csrc/moe/moe_sum_reduce.cu",
+    "csrc/moe/moe_topk_softmax_kernels.cu",
+    "csrc/moe/moe_topk_sigmoid_kernels.cu",
+    "csrc/moe/prepare_moe_input.cu",
+    "csrc/quantization/gguf/gguf_kernel.cu",
+]
+
+# Third-party source files.
+flashinfer_sources = [
+    str(_FLASHINFER_REPO.source_dir / "csrc" / "norm.cu"),
+    str(_FLASHINFER_REPO.source_dir / "csrc" / "renorm.cu"),
+]
+
+# setuptools rejects absolute source paths (build_py.analyze_manifest calls
+# assert_relative on every entry written to SOURCES.txt). Relativize against
+# `root` and always build from this directory so the paths resolve.
+all_common_sources = [
+    s if not os.path.isabs(s) else os.path.relpath(s, root)
+    for s in common_sources + flashinfer_sources
+]
+
+# The SAIL PPU SDK ships real CUDA runtime/BLAS libraries, so link the
+# standard CUDA spellings (matching the upstream CUDA build).
+libraries = ["c10", "cuda", "cublas", "cublasLt"]
+extra_link_args = ["-Wl,-rpath,$ORIGIN/../../torch/lib"]
+
+
+# ======================= Extension Modules ======================= #
+def _make_common_ops():
+    """common_ops for SM80."""
+    nvcc_flags = sgl_kernel_cuda_flags + ["-use_fast_math"]
+    return CUDAExtension(
+        name="sgl_kernel.common_ops",
+        sources=all_common_sources,
+        include_dirs=include_dirs,
+        extra_compile_args={
+            "nvcc": nvcc_flags,
+            "cxx": ["-O3", "-std=c++17", abi_flag],
+        },
+        libraries=libraries,
+        extra_link_args=extra_link_args,
+        py_limited_api=False,
+    )
+
+
+# ======================= Clone Third-Party Repositories ======================= #
+def _clone_and_checkout(repo_path, repo_url, git_tag, git_shallow):
+    """Clone a git repository and checkout a specific tag/commit."""
+    repo_path = Path(repo_path)
+    repo_path.parent.mkdir(parents=True, exist_ok=True)
+    if not repo_path.exists():
+        clone_cmd = ["git", "clone"]
+        if git_shallow:
+            clone_cmd += ["--depth", "1"]
+        clone_cmd += [repo_url, str(repo_path)]
+        print(f"Cloning {repo_url} -> {repo_path}")
+        subprocess.check_call(clone_cmd)
+        subprocess.check_call(["git", "checkout", git_tag], cwd=repo_path)
+
+
+if os.environ.get("SGL_KERNEL_SKIP_THIRD_PARTY", "0") != "1":
+    for _repo in ALL_REPOS:
+        _clone_and_checkout(
+            _repo.source_dir,
+            _repo.git_repository,
+            _repo.git_tag,
+            _repo.git_shallow,
+        )
+
+
+# ======================= Build Extension Modules List ======================= #
+ext_modules = [
+    _make_common_ops(),
+]
+
+
+# ======================= Custom Build Extension ======================= #
+class _CustomBuildExt(BuildExtension):
+    """Custom build extension with ninja support."""
+
+    pass
+
+
+# ======================= Package Discovery ======================= #
+_triton_kernels_root = _TRITON_REPO.source_dir / "python" / "triton_kernels"
+
+_packages = find_namespace_packages(where="python")
+_package_dir = {"": "python"}
+
+# Discover triton_kernels packages (may not exist before first clone)
+if _triton_kernels_root.exists():
+    _triton_pkgs = find_namespace_packages(
+        where=str(_triton_kernels_root),
+        exclude=["tests", "tests.*"],
+    )
+else:
+    _triton_pkgs = ["triton_kernels"]
+
+for pkg in _triton_pkgs:
+    _package_dir[pkg] = os.path.relpath(
+        _triton_kernels_root / pkg.replace(".", os.sep), root
+    )
+_packages += _triton_pkgs
+
+
+# ======================= Setup ======================= #
+setup(
+    name="sglang-kernel",
+    version=_get_version(),
+    packages=_packages,
+    package_dir=_package_dir,
+    ext_modules=ext_modules,
+    cmdclass={"build_ext": _CustomBuildExt.with_options(use_ninja=True)},
+    options={"bdist_wheel": {"py_limited_api": "cp310"}},
+)
